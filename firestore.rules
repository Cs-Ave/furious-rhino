rules_version = '2';

// Security Rules do Firestore do FURIOUS RHINO.
// ⚠️ Este arquivo NÃO é aplicado automaticamente: publique o conteúdo em
// console.firebase.google.com → projeto furious-rhino → Firestore → Regras.
// Ordem crítica de release: publicar as rules ANTES do deploy do código
// (são retrocompatíveis; a ordem inversa rejeita writes EM SILÊNCIO).
service cloud.firestore {
  match /databases/{database}/documents {

    // Parâmetros das notificações do administrador (v1.6.1). Leitura pública
    // porque quem publica no ntfy é o navegador do jogador; escrita SÓ pelo
    // console do Firebase — assim os limiares mudam sem deploy e ninguém de
    // fora consegue redirecionar ou desligar os pushes.
    // Doc esperado: config/notify — os campos ausentes caem nos defaults de
    // js/notify-config.js. Bloco isolado: não compete pelo orçamento de
    // avaliação da coleção `stats`.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Ranking público — 1 doc por aparelho, só melhora
    match /scores/{playerId} {
      function validEntry() {
        return request.resource.data.keys().hasOnly(['name', 'nameLower', 'score', 'scoreAt', 'skin', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 12
          // v1.5.0: chave de unicidade do apelido (sem acento/caixa).
          // OPCIONAL — clientes v1.4 em cache continuam gravando sem ela.
          && (!('nameLower' in request.resource.data)
              || (request.resource.data.nameLower is string
                  && request.resource.data.nameLower.size() >= 3
                  && request.resource.data.nameLower.size() <= 12))
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 10000
          // v1.8: quando ESTA marca foi atingida (mostra "há X dias" no top
          // 10). OPCIONAL (clientes velhos gravam sem ele); <= request.time
          // porque a troca de apelido REESCREVE o valor antigo (não pode ser
          // == request.time como o updatedAt)
          && (!('scoreAt' in request.resource.data)
              || (request.resource.data.scoreAt is timestamp
                  && request.resource.data.scoreAt <= request.time))
          // v1.8.1: id da skin usada QUANDO a marca foi cravada — vitrine do
          // pódio da tela inicial. OPCIONAL; preservado na troca de apelido
          // pela cópia local (mesmo esquema do scoreAt)
          && (!('skin' in request.resource.data)
              || (request.resource.data.skin is string
                  && request.resource.data.skin.size() >= 1
                  && request.resource.data.skin.size() <= 24))
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validEntry() && playerId.size() >= 16 && playerId.size() <= 40;
      // >= (era >) para a troca de apelido reescrever o doc mantendo o
      // score; continua impossível DIMINUIR a marca
      allow update: if validEntry() && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    // Telemetria — escrita pelo jogo; leitura PÚBLICA (o painel /?stats
    // agrega no cliente). Docs anônimos: chave é UUID aleatório, sem nome
    // e sem IP. Totais acumulados por aparelho, monotônicos nos núcleos.
    //
    // ⚠️ Estrutura ANINHADA de propósito (deaths/client/geo são mapas):
    // rules com dezenas de cláusulas sobre 20+ campos soltos estouram o
    // orçamento de avaliação do Firestore e passam a NEGAR writes legítimos
    // (constatado na prática: 19 campos passavam, 20 falhavam). Manter as
    // regras desta coleção ENXUTAS.
    match /stats/{playerId} {
      function core(f) {
        return request.resource.data[f] is int
          && request.resource.data[f] >= 0
          && request.resource.data[f] <= 100000000;
      }
      function validStats() {
        return request.resource.data.keys().hasOnly(
            ['attempts', 'playTimeS', 'wins', 'bestM', 'deaths', 'runs',
             'client', 'geo', 'history', 'standalone', 'gameVersion', 'updatedAt'])
          && request.resource.data.keys().hasAll(
            ['attempts', 'playTimeS', 'wins', 'bestM', 'deaths', 'updatedAt'])
          && core('attempts') && request.resource.data.attempts >= 1
          && core('playTimeS') && core('wins')
          && core('bestM') && request.resource.data.bestM <= 10000
          && request.resource.data.deaths is map
          && request.resource.data.deaths.size() <= 14
          && (!('runs' in request.resource.data)
              || (request.resource.data.runs is list
                  && request.resource.data.runs.size() <= 50))
          // v1.5.0: histórico acumulado (clients/geos/versions/firstSeenS).
          // Validado como UM mapa — os tetos internos ficam no cliente
          // (StorageManager.HISTORY_CAPS) para não gastar orçamento aqui
          && (!('history' in request.resource.data)
              || (request.resource.data.history is map
                  && request.resource.data.history.size() <= 6))
          && (!('client' in request.resource.data)
              || (request.resource.data.client is map
                  && request.resource.data.client.size() <= 10))
          && (!('geo' in request.resource.data)
              || (request.resource.data.geo is map
                  && request.resource.data.geo.size() <= 4))
          && (!('standalone' in request.resource.data)
              || request.resource.data.standalone is bool)
          && (!('gameVersion' in request.resource.data)
              || (request.resource.data.gameVersion is string
                  && request.resource.data.gameVersion.size() <= 10))
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if validStats() && playerId.size() >= 16 && playerId.size() <= 40;
      allow update: if validStats()
        && request.resource.data.attempts >= resource.data.attempts
        && request.resource.data.playTimeS >= resource.data.playTimeS
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.bestM >= resource.data.bestM;
      allow delete: if false;
    }
  }
}
